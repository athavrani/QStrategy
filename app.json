{
  "expo": {
    "name": "QStrategy",
    "slug": "qstrategy",
    "scheme": "qstrategy",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#080A0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.qstrategy.app",
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withBackgroundMonitor",
      [
        "expo-local-authentication",
        {
          "faceDetectorSettings": {}
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27263f37-6b62-43e5-9d13-9dbedc987730"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/athavrani/QStrategy/main/app.json",
      "apkDownloadUrl": "https://github.com/athavrani/QStrategy/releases/latest/download/QStrategy.apk",
      "releaseNotes": "v1.1.1: Fixes the NIFTY 09:20 OOBTST strike selection. The strikes now lock at 09:20:05 on the 09:20 candle open (read from Dhan intraday data) instead of the live price, and only opens between 50 and 75 can be locked. If the candle opens are unavailable by 09:21:05 the lock fails instead of picking a wrong strike. The lock record keeps an audit of the candidates it saw."
    },
    "owner": "quantpulse"
  }
}

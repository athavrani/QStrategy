      "eas": {
        "projectId": "27263f37-6b62-43e5-9d13-9dbedc987730"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/athavrani/QStrategy/main/app.json",
      "apkDownloadUrl": "https://github.com/athavrani/QStrategy/releases/latest/download/QStrategy.apk",
      "releaseNotes": "OOBTST locks now rank on the 09:20 candle open (fixes SENSEX 74800 CE vs 75000 CE and NIFTY Lock Failed) with an automatic 30 s retry until 09:21. New Retry button on failed NIFTY/SENSEX 09:20 OOBTST and NIFTY 09:25 Breakout 180 locks: locks on the 09:20/09:21 (breakout 09:25/09:26) candle open when available, otherwise on the latest prices."
    },
    "owner": "quantpulse"
  }
}

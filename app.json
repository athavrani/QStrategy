{
  "expo": {
    "name": "QStrategy",
    "slug": "qstrategy",
    "scheme": "qstrategy",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#080A0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.qstrategy.app",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withBackgroundMonitor",
      [
        "expo-local-authentication",
        {
          "faceDetectorSettings": {}
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27263f37-6b62-43e5-9d13-9dbedc987730"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/athavrani/QStrategy/main/app.json",
      "apkDownloadUrl": "https://github.com/athavrani/QStrategy/releases/latest/download/QStrategy.apk",
      "releaseNotes": "v1.1.0: Adds Dhan order execution. New Orders tab. Settings gain the Dhan IP whitelist, sandbox testing, execution mode and limits, a daily live-trading arm switch and a readiness check. Live orders are off by default: they need Confirm mode, daily arming, your confirmation and a biometric check, and are limited to one lot. Filled entries get an exchange stop-loss, with Exit now and Exit all. Read ORDER_EXECUTION_RUNBOOK.md before using real money."
    },
    "owner": "quantpulse"
  }
}

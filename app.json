{
  "expo": {
    "name": "QStrategy",
    "slug": "qstrategy",
    "scheme": "qstrategy",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#080A0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.qstrategy.app",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withBackgroundMonitor",
      [
        "expo-local-authentication",
        {
          "faceDetectorSettings": {}
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27263f37-6b62-43e5-9d13-9dbedc987730"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/athavrani/QStrategy/main/app.json",
      "apkDownloadUrl": "https://github.com/athavrani/QStrategy/releases/latest/download/QStrategy.apk",
      "releaseNotes": "v1.1.2: Fixes the app version shown under Settings > App version & updates. The installed version and build now come from the installed app itself, so they are always correct and update checks compare the right numbers. Also includes the Radar sort options (Newest first by default, Oldest, Volume %, Price %, A-Z) for the stock list and the Buy/Sell/Near filters."
    },
    "owner": "quantpulse"
  }
}

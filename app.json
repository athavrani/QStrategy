{
  "expo": {
    "name": "QStrategy",
    "slug": "qstrategy",
    "scheme": "qstrategy",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#080A0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.qstrategy.app",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withBackgroundMonitor",
      [
        "expo-local-authentication",
        {
          "faceDetectorSettings": {}
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27263f37-6b62-43e5-9d13-9dbedc987730"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/athavrani/QStrategy/main/app.json",
      "apkDownloadUrl": "https://github.com/athavrani/QStrategy/releases/latest/download/QStrategy.apk",
      "releaseNotes": "Re-lock button: after Step 1 is locked, re-select the OOBTST (Nifty, Sensex) and 09:25 Breakout strikes from the latest prices and lock the new price. Refused once a leg has triggered or a trade is taken; a failed re-lock keeps the current lock."
    },
    "owner": "quantpulse"
  }
}

{
  "expo": {
    "name": "QStrategy",
    "slug": "qstrategy",
    "scheme": "qstrategy",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#080A0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.qstrategy.app",
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withBackgroundMonitor",
      [
        "expo-local-authentication",
        {
          "faceDetectorSettings": {}
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27263f37-6b62-43e5-9d13-9dbedc987730"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/athavrani/QStrategy/main/app.json",
      "apkDownloadUrl": "https://github.com/athavrani/QStrategy/releases/latest/download/QStrategy.apk",
      "releaseNotes": "Fix: the 09:20 OOBTST lock now picks the strike nearest the target premium even when it is far from spot (SENSEX and NIFTY), and strikes now lock while the app is minimized or in the background. The 09:20 candle opens are saved on the device, the foreground service drives the clock evaluation, and the app catches up when reopened. Re-lock still uses live prices."
    },
    "owner": "quantpulse"
  }
}

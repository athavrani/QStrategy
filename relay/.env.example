# Copy to .env and fill in. Never commit .env.

# Public hostname that points at this host (ports 80 and 443 must be open). Used by Caddy for HTTPS.
DOMAIN=relay.example.com

# --- Optional ---
# Per-account and overall request limits (Dhan allows 10 order requests per second per account).
# TENANT_RATE_PER_SEC=8
# GLOBAL_RATE_PER_SEC=50

# Send all Dhan traffic through a fixed-IP HTTP proxy so this relay can run on any host.
# UPSTREAM_PROXY=http://user:pass@static-node:3128

# Seconds the phone clock may differ from this host before requests are refused.
# CLOCK_SKEW_SECONDS=30

# Refuse orders or modifications above this quantity (0 = no limit).
# MAX_ORDER_QUANTITY=0

# Most Dhan accounts this relay will serve (default 2). Dhan allows one IP to be shared only
# between family members and only with its approval, so raise this only if Dhan has approved it.
# MAX_ACCOUNTS=2

# Get a plain-text POST (works with ntfy.sh topics) when this host's public IP changes,
# because Dhan rejects orders from an IP that is not whitelisted. Checked every few minutes.
# ALERT_WEBHOOK_URL=https://ntfy.sh/your-private-topic
# EGRESS_WATCH_MINUTES=5

# Point the relay at the Dhan sandbox for testing.
# DHAN_BASE_URL=https://sandbox.dhan.co/v2
